{
  "manifest_version": 2,
  "name": "__MSG_appName__",
  "version": "1.9.1",
  "description": "__MSG_appDescription__",
  "author": "jctots (fork of zoott28354); VirgilWa fork",
  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-translator@virgilwa",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "messagesRead",
    "messagesModify",
    "compose",
    "storage",
    "tabs",
    "menus",
    "https://tokenhub.tencentmaas.com/*"
  ],

  "message_display_action": {
    "default_title": "__MSG_translate__",
    "default_icon": {
      "48": "icons/translate-dark.svg",
      "96": "icons/translate-dark.svg"
    },
    "theme_icons": [{
      "light": "icons/translate-light.svg",
      "dark":  "icons/translate-dark.svg",
      "size": 48
    }]
  },

  "compose_action": {
    "default_title": "__MSG_translate__",
    "default_icon": {
      "48": "icons/translate-dark.svg",
      "96": "icons/translate-dark.svg"
    },
    "theme_icons": [{
      "light": "icons/translate-light.svg",
      "dark":  "icons/translate-dark.svg",
      "size": 48
    }]
  },

  "background": {
    "scripts": ["shared/runtime-policy.js", "providers.js", "translation-router.js", "background.js"]
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "icons": {
    "48": "icons/translate-dark.svg",
    "96": "icons/translate-dark.svg"
  }
}
